{
  "name": "retry-function",
  "version": "4.0.0",
  "homepage": "https://github.com/petey/retry-function",
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git://github.com/petey/retry-function.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "retry": "^0.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/retry": "^0",
